<?xml version="1.0" encoding="utf-8"?>
<!-- Long-press the app icon: Settings (the icon itself switches the dots on and off). -->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:shortcutId="settings"
        android:enabled="true"
        android:icon="@mipmap/ic_launcher"
        android:shortcutShortLabel="@string/settings">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetPackage="com.motiondots.app"
            android:targetClass="com.motiondots.app.MainActivity" />
    </shortcut>
</shortcuts>
